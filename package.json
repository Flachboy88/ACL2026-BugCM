{
  "name": "agenda-bugcm",
  "type": "module",
  "version": "0.1.0",
  "description": "Application Web de gestion d'agendas (projet ACL 2026, équipe BugCM)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --import ./test/setup.js --test \"test/**/*.test.js\"",
    "db:reset": "node server/resetDatabase.js", 
    "db:rebuild": "npm run db:reset && npm run init_Db",
    "init_Db" : "node server/initialize.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}

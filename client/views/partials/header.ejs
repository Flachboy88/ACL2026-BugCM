<!-- client/views/partials/header.ejs -->
<script>
    // ce truc permet de charger imédiatement le thème sur la page. Si il est retiré le theme ne charge pas assez vite et on voie la transition de theme a chaque changement de pages.
    // Il faudrais utiliser des cookie pour régler le pb sinon. 
    (function() {
        const savedTheme = localStorage.getItem('selected_theme') || 'claire';
        document.documentElement.setAttribute('data-theme', savedTheme);
    })();
</script>


<div id="header">
    <button id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="agenda_panel">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <line class="trait haut"   x1="3" y1="6"  x2="21" y2="6"  />
        <line class="trait milieu" x1="3" y1="12" x2="21" y2="12" />
        <line class="trait bas"    x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <h1>Agenda BugCM</h1>

    <!-- Avatar with its dropdown menu (will be able to show a photo later) -->
    <div class="profil_menu">
        <button type="button" id="pastille_profil" class="pastille_profil"
                aria-haspopup="true" aria-expanded="false" aria-controls="menu_profil"
                aria-label="Menu du profil">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="4"></circle>
                <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
            </svg>
        </button>

        <div id="menu_profil" class="menu_profil" hidden>
            <a href="/profil">Voir profil</a>
            <button type="button" id="logout">Déconnexion</button>
            <button type="button" id="bouton_themes_ouvrir">Thèmes</button>
        </div>
    </div>

    <div id="barre_themes_id" class="barre_themes">
        <div class="barre_themes_header">
            <h3>Choisir un thème</h3>
            <button type="button" id="bouton_themes_fermer">✕</button>
        </div>
        
        <div class="theme_liste">
            <button type="button" class="theme-option" data-set-theme="claire">
                Claire
            </button>
            
            <button type="button" class="theme-option" data-set-theme="sombre">
                Sombre
            </button>
        </div>
    </div>

    <script src="/js/profilMenu.js"></script>
    <script src="/js/logout.js"></script>
    <script src="/js/theme.js"></script>
</div>

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Connexion - Agenda BugCM</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <div id="auth_container">
        <div class="auth">
            <form id="form-login">
                <h2>Connexion</h2>
                <div class="field">
                    <label for="login-email">Adresse e-mail</label>
                    <input id="login-email" type="email" name="email" placeholder="dupont@mailer.tv" required autocomplete="username">
                </div>
                <div class="field">
                    <label for="login-password">Mot de passe</label>
                    <input id="login-password" type="password" name="pwd" placeholder="pwd" required autocomplete="current-password">
                </div>
                <input type="submit" value="Se connecter" class="bouton">
            </form>
            <p class="switch">Pas de compte ? <a href="/register">S'inscrire</a></p>
        </div>
    </div>

    <script src="/js/login.js"></script>

</body>
</html>

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Agenda BugCM</title>
    <link rel="stylesheet" href="css/style.css">
    <!-- FullCalendar Scheduler (Premium), used by the current calendar.js -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar-scheduler@6.1.11/index.global.min.js"></script>
</head>
<body>
    
    <%- include('partials/header') %>

    <div id="containter">

        <div id="agenda_panel">
            <h2>Mes agendas</h2>
            <hr>
            <div id="agenda_list"></div>

            <form id="agenda_form">
                <label for="agenda_nom"></label><input type="text" id="agenda_nom" placeholder="Nom de l'agenda" required>
                <label for="agenda_couleur"></label><input type="color" id="agenda_couleur" value="#3788d8">
                <button type="submit">Créer</button>
                <p id="agenda_erreur"></p>
            </form>
        </div>
        
        <div id="calendar"></div>
    </div>

    <script type="module" src="js/main.js"></script>

</body>
</html>

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Mot de passe oublié - Agenda BugCM</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login">

    <%- include('partials/header') %>

    <div id="auth_container">
        <div class="auth">
            <form id="form-forget-pwd">
                <h2>Mot de passe oublié</h2>
                <div class="field">
                    <label for="account-email">Adresse e-mail</label>
                    <input id="account-email" type="email" name="email" placeholder="dupont@mailer.tv" required autocomplete="email">
                </div>
                <p id="forget-error" class="erreur"></p>
                <p id="forget-message" class="message"></p>
                <input type="submit" value="Envoyer la demande" class="bouton">
            </form>
            <p class="switch"><a href="/login">Retour à la connexion</a></p>
            
            <a id="demo_button" class="bouton" href="#" target="_blank" rel="noopener noreferrer" hidden>
                DEMO : voir le mail
            </a>

        </div>
    </div>

    <script src="/js/forget.js"></script>

</body>
</html>

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mon profil</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="profil">

<%- include('partials/header') %>

<main class="profil_page">

    <section class="profil_carte">

        <!-- En-tête du profil -->
        <div class="profil_header">

            <div class="profil_avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                </svg>
            </div>

            <div class="profil_titre">
                <h2>Mon profil</h2>
                <p>Consultez les informations de votre compte</p>
            </div>

        </div>

        <div class="profil_separateur"></div>

        <!-- Informations personnelles -->
        <div class="profil_informations">

            <div class="profil_information">
                <div class="profil_icone">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                    </svg>
                </div>

                <div class="profil_texte">
                    <span>Nom</span>
                    <p><%= utilisateur.nom %></p>
                </div>
            </div>

            <div class="profil_information">
                <div class="profil_icone">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <path d="m3 7 9 6 9-6"></path>
                    </svg>
                </div>

                <div class="profil_texte">
                    <span>Adresse email</span>
                    <p><%= utilisateur.email %></p>
                </div>

            </div>

            <div class="profil_information">
                <div class="profil_icone">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="10" width="18" height="11" rx="2"></rect>
                        <path d="M7 10V7a5 5 0 0 1 10 0v3"></path>
                    </svg>
                </div>

                <div class="profil_texte">
                    <span>Mot de passe</span>
                    <p>••••••••••••</p>
                </div>

                <button type="button" class="bouton_modifier_mdp" title="Modifier le mot de passe" aria-label="Modifier le mot de passe"
                        aria-expanded="false" aria-controls="form_mot_de_passe">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                    </svg>
                </button>
            </div>

            <!-- Password change form, unfolded by the pencil button above -->
            <form id="form_mot_de_passe" class="form_mot_de_passe" hidden>
                <label for="nouveau_mdp">Nouveau mot de passe</label>
                <input type="password" id="nouveau_mdp" name="password" required>

                <label for="confirmer_mdp">Confirmer le mot de passe</label>
                <input type="password" id="confirmer_mdp" name="confirmPassword" required>

                <p id="message_mdp" class="message_mdp" hidden></p>

                <div class="form_mot_de_passe_actions">
                    <button type="submit">Enregistrer</button>
                </div>
            </form>

        </div>

        <div class="profil_separateur"></div>

        <div class="profil_pied">
            <p>Ces informations sont associées à votre compte.</p>
        </div>
        <a href="/" class="bouton_accueil">
            Retour à l'accueil
        </a>

    </section>


</main>

<script src="/js/modifierMotDePasse.js"></script>

</body>

</html>